# Vercel / API secrets — NEVER commit real values
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-32-plus-character-secret
TOTP_ENCRYPTION_KEY=replace-with-fernet-key
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-12-plus-character-password
ADMIN_BOOTSTRAP_SECRET=replace-with-random-bootstrap-secret

# Exchange credentials are intentionally not required in paper mode.
# If ever enabled after validation, use Vercel Environment Variables only.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
